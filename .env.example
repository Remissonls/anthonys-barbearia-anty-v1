# AgendaPro Environment Variables

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Demo Mode (Set to true to explore AgendaPro locally without Supabase credentials)
# Defaults to true if Supabase URL is not provided
VITE_DEMO_MODE=true

# Default Timezone (IANA)
VITE_DEFAULT_TIMEZONE=America/Maceio
